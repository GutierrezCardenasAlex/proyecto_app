    },
    {
      "id": "poi-sports-plazas",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "poi",
      "minzoom": 12,
      "filter": [
        "all",
        [
          "match",
          [
            "get",
            "class"
